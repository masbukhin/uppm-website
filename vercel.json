{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/snapshot.mjs": { "includeFiles": "server/schema.sql" },
    "api/health.mjs": { "includeFiles": "server/schema.sql" },
    "api/verify.mjs": { "includeFiles": "server/schema.sql" }
  },
  "rewrites": [
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ]
}
