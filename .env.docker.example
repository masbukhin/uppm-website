# Copy to `.env` on the VPS (same folder as docker-compose.yml) and fill in.
# Never commit the real .env file.

# Image pulled by `docker compose pull` (pushed by GitHub Actions).
APP_IMAGE=ghcr.io/masbukhin/uppm-website:latest

# Public port on the VPS. Put Nginx/Caddy in front for HTTPS, or set APP_PORT=80.
APP_BIND=0.0.0.0
APP_PORT=8080
APP_ORIGIN=https://uppm.example.ac.id

# MySQL (container `db`). Use long random passwords.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=uppm
MYSQL_USER=uppm
MYSQL_PASSWORD=change-me-app
MYSQL_CONNECTION_LIMIT=10

# Cloudflare Turnstile server secret (optional).
TURNSTILE_SECRET_KEY=

# Only used if you build the image on the VPS itself (`docker compose build`).
# For GitHub Actions builds, set these as repository Variables instead.
VITE_GEMINI_API_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_APP_URL=
