# VITE_GEMINI_API_KEY: Optional. Required only for Gemini AI helper buttons.
# Copy this file to .env, fill the value below, then restart `npm run dev`.
VITE_GEMINI_API_KEY=""

# VITE_TURNSTILE_SITE_KEY: Optional. Fill with a Cloudflare Turnstile site key
# to replace the local human-check checkbox on the login page.
VITE_TURNSTILE_SITE_KEY=""

# TURNSTILE_SECRET_KEY: Required on the server when VITE_TURNSTILE_SITE_KEY is used.
# The login page sends Turnstile tokens to /api/verify-turnstile for real Cloudflare validation.
TURNSTILE_SECRET_KEY=""

# KV_REST_API_URL and KV_REST_API_TOKEN: Required on Vercel for persistent database snapshots.
# Create/connect Vercel KV (or Upstash Redis) so accounts and ST numbers survive refresh/deploy.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# APP_URL: The URL where this applet is hosted.
# Used only when you add deployment-specific integrations later.
VITE_APP_URL="http://localhost:3000"

# MySQL 8+ database used by the local backend.
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="uppm"
MYSQL_CONNECTION_LIMIT="10"
MYSQL_CREATE_DATABASE="true"
MYSQL_SSL="false"
MYSQL_SSL_REJECT_UNAUTHORIZED="true"

# Vercel + TiDB Cloud mengisi TIDB_HOST, TIDB_PORT, TIDB_USER,
# TIDB_PASSWORD, dan TIDB_DATABASE secara otomatis. Backend menerima
# variabel tersebut sebagai alternatif MYSQL_* dan otomatis memakai TLS.
APP_ORIGIN="http://localhost:3000"
